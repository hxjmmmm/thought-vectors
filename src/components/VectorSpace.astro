---
// 3D 向量空间球 — 思维向量首页可视化
---

<div id="vector-space-container" class="vector-space-container">
  <canvas id="vector-space-canvas"></canvas>
</div>

<style>
  .vector-space-container {
    width: 100%;
    height: 420px;
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    background: radial-gradient(ellipse at center, #0f172a 0%, #020617 100%);
    cursor: grab;
  }
  .vector-space-container:active {
    cursor: grabbing;
  }
  .vector-space-container canvas {
    display: block;
  }
  @media (max-width: 768px) {
    .vector-space-container {
      height: 300px;
    }
  }
</style>

<script>
  import * as THREE from 'three';

  const container = document.getElementById('vector-space-container');
  const canvas = document.getElementById('vector-space-canvas');

  // 场景
  const scene = new THREE.Scene();

  // 相机
  const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 100);
  camera.position.z = 6;

  // 渲染器
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setSize(container.clientWidth, container.clientHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

  // --- 球体框架 ---
  const sphereGeo = new THREE.SphereGeometry(1.8, 48, 32);
  const sphereWire = new THREE.LineSegments(
    new THREE.WireframeGeometry(sphereGeo, 1),
    new THREE.LineBasicMaterial({ color: 0x3b82f6, transparent: true, opacity: 0.12 })
  );
  scene.add(sphereWire);

  // 外层光晕
  const glowGeo = new THREE.SphereGeometry(1.82, 64, 32);
  const glowMat = new THREE.ShaderMaterial({
    uniforms: {
      uTime: { value: 0 },
      uColor: { value: new THREE.Color('#3b82f6') },
    },
    vertexShader: /* glsl */ `
      varying vec3 vNormal;
      varying vec3 vPosition;
      void main() {
        vec4 mvPosition = modelViewMatrix * vec4(position, 1.0);
        gl_Position = projectionMatrix * mvPosition;
        vNormal = normalize(normalMatrix * normal);
        vPosition = position;
      }
    `,
    fragmentShader: /* glsl */ `
      varying vec3 vNormal;
      varying vec3 vPosition;
      uniform float uTime;
      uniform vec3 uColor;
      void main() {
        float intensity = pow(0.65 - dot(vNormal, vec3(0.0, 0.0, 1.0)), 2.5);
        float alpha = intensity * 0.25 + 0.03 * sin(uTime * 0.5 + vPosition.y * 5.0);
        gl_FragColor = vec4(uColor, alpha);
      }
    `,
    transparent: true,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
  });
  const glowSphere = new THREE.Mesh(glowGeo, glowMat);
  scene.add(glowSphere);

  // --- 粒子 —— 思维向量 ---
  const PARTICLE_COUNT = 200;
  const particlesGeo = new THREE.BufferGeometry();
  const positions = new Float32Array(PARTICLE_COUNT * 3);
  const colors = new Float32Array(PARTICLE_COUNT * 3);
  const velocities = new Float32Array(PARTICLE_COUNT * 3); // 速度向量

  // 蓝紫粉渐变色调
  const palette = [
    new THREE.Color('#3b82f6'), // 蓝
    new THREE.Color('#8b5cf6'), // 紫
    new THREE.Color('#ec4899'), // 粉
    new THREE.Color('#60a5fa'), // 浅蓝
    new THREE.Color('#a78bfa'), // 浅紫
  ];

  for (let i = 0; i < PARTICLE_COUNT; i++) {
    // 球体内随机分布
    const theta = Math.random() * Math.PI * 2;
    const phi = Math.acos(2 * Math.random() - 1);
    const r = 1.7 * Math.cbrt(Math.random()); // 均匀分布在球体内
    positions[i * 3] = r * Math.sin(phi) * Math.cos(theta);
    positions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta);
    positions[i * 3 + 2] = r * Math.cos(phi);

    const color = palette[Math.floor(Math.random() * palette.length)];
    colors[i * 3] = color.r;
    colors[i * 3 + 1] = color.g;
    colors[i * 3 + 2] = color.b;

    velocities[i * 3] = (Math.random() - 0.5) * 0.003;
    velocities[i * 3 + 1] = (Math.random() - 0.5) * 0.003;
    velocities[i * 3 + 2] = (Math.random() - 0.5) * 0.003;
  }

  particlesGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  particlesGeo.setAttribute('color', new THREE.BufferAttribute(colors, 3));

  // 圆形粒子纹理
  const particleCanvas = document.createElement('canvas');
  particleCanvas.width = 32;
  particleCanvas.height = 32;
  const ctx = particleCanvas.getContext('2d');
  const gradient = ctx.createRadialGradient(16, 16, 0, 16, 16, 16);
  gradient.addColorStop(0, 'rgba(255,255,255,1)');
  gradient.addColorStop(0.15, 'rgba(255,255,255,0.8)');
  gradient.addColorStop(0.4, 'rgba(255,255,255,0.3)');
  gradient.addColorStop(1, 'rgba(255,255,255,0)');
  ctx.fillStyle = gradient;
  ctx.fillRect(0, 0, 32, 32);
  const particleTexture = new THREE.CanvasTexture(particleCanvas);

  const particlesMat = new THREE.PointsMaterial({
    size: 0.05,
    map: particleTexture,
    vertexColors: true,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    transparent: true,
    opacity: 0.85,
  });

  const particles = new THREE.Points(particlesGeo, particlesMat);
  scene.add(particles);

  // --- 连线 ---
  const CONNECTION_COUNT = 80;
  const connectionsGroup = new THREE.Group();
  const connections = [];

  for (let i = 0; i < CONNECTION_COUNT; i++) {
    const a = Math.floor(Math.random() * PARTICLE_COUNT);
    let b = Math.floor(Math.random() * PARTICLE_COUNT);
    while (b === a) b = Math.floor(Math.random() * PARTICLE_COUNT);

    const lineGeo = new THREE.BufferGeometry();
    const linePositions = new Float32Array(6);
    lineGeo.setAttribute('position', new THREE.BufferAttribute(linePositions, 3));
    const lineMat = new THREE.LineBasicMaterial({
      color: palette[Math.floor(Math.random() * palette.length)],
      transparent: true,
      opacity: 0.15 + Math.random() * 0.15,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
    });
    const line = new THREE.Line(lineGeo, lineMat);
    connectionsGroup.add(line);
    connections.push({ line, a, b });
  }
  scene.add(connectionsGroup);

  // --- 坐标轴环 ---
  function createRing(rotation, color) {
    const ringGeo = new THREE.TorusGeometry(1.82, 0.003, 16, 100);
    const ringMat = new THREE.MeshBasicMaterial({ color, transparent: true, opacity: 0.2 });
    const ring = new THREE.Mesh(ringGeo, ringMat);
    ring.rotation.set(...rotation);
    return ring;
  }
  scene.add(createRing([Math.PI / 2, 0, 0], 0x3b82f6));
  scene.add(createRing([0, Math.PI / 2, 0], 0x8b5cf6));
  scene.add(createRing([0, 0, Math.PI / 2], 0xec4899));

  // --- 鼠标交互 ---
  let mouseX = 0, mouseY = 0;
  let targetRotX = 0, targetRotY = 0;
  let isDragging = false;
  let prevMouseX = 0, prevMouseY = 0;

  container.addEventListener('mousemove', (e) => {
    const rect = container.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
    const y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
    if (isDragging) {
      targetRotY += (x - prevMouseX) * 2;
      targetRotX += (y - prevMouseY) * 2;
    }
    prevMouseX = x;
    prevMouseY = y;
    mouseX = x;
    mouseY = y;
  });

  container.addEventListener('mousedown', () => { isDragging = true; });
  container.addEventListener('mouseup', () => { isDragging = false; });
  container.addEventListener('mouseleave', () => { isDragging = false; });

  // 触摸支持
  container.addEventListener('touchmove', (e) => {
    if (e.touches.length === 1) {
      const rect = container.getBoundingClientRect();
      const x = ((e.touches[0].clientX - rect.left) / rect.width) * 2 - 1;
      const y = -((e.touches[0].clientY - rect.top) / rect.height) * 2 + 1;
      targetRotY += (x - prevMouseX) * 2;
      targetRotX += (y - prevMouseY) * 2;
      prevMouseX = x;
      prevMouseY = y;
    }
  });

  // --- 动画循环 ---
  const clock = new THREE.Clock();

  function animate() {
    requestAnimationFrame(animate);

    const dt = Math.min(clock.getDelta(), 0.1);
    const t = performance.now() * 0.001;

    // 自动旋转（无拖拽时）
    if (!isDragging) {
      targetRotY += dt * 0.15;
      targetRotX += dt * 0.05;
    }

    // 平滑跟随
    targetRotY += (mouseX * 0.3 - targetRotY) * 0.02;
    targetRotX += (mouseY * 0.2 - targetRotX) * 0.02;

    // 旋转场景
    scene.rotation.y += (targetRotY - scene.rotation.y) * 0.05;
    scene.rotation.x += (targetRotX - scene.rotation.x) * 0.05;

    // 更新光晕
    glowMat.uniforms.uTime.value = t;

    // 更新粒子位置
    const posArray = particlesGeo.attributes.position.array;
    for (let i = 0; i < PARTICLE_COUNT; i++) {
      const idx = i * 3;
      // 应用速度
      posArray[idx] += velocities[idx];
      posArray[idx + 1] += velocities[idx + 1];
      posArray[idx + 2] += velocities[idx + 2];

      // 边界反弹
      const dist = Math.sqrt(
        posArray[idx] ** 2 + posArray[idx + 1] ** 2 + posArray[idx + 2] ** 2
      );
      if (dist > 1.7) {
        const nx = posArray[idx] / dist;
        const ny = posArray[idx + 1] / dist;
        const nz = posArray[idx + 2] / dist;
        // 反弹 + 随机扰动
        const dot = velocities[idx] * nx + velocities[idx + 1] * ny + velocities[idx + 2] * nz;
        velocities[idx] -= 2 * dot * nx;
        velocities[idx + 1] -= 2 * dot * ny;
        velocities[idx + 2] -= 2 * dot * nz;
        velocities[idx] += (Math.random() - 0.5) * 0.001;
        velocities[idx + 1] += (Math.random() - 0.5) * 0.001;
        velocities[idx + 2] += (Math.random() - 0.5) * 0.001;
        // 推回球内
        posArray[idx] = nx * 1.68;
        posArray[idx + 1] = ny * 1.68;
        posArray[idx + 2] = nz * 1.68;
      }
    }
    particlesGeo.attributes.position.needsUpdate = true;

    // 更新连线
    for (const conn of connections) {
      const linePositions = conn.line.geometry.attributes.position.array;
      const aIdx = conn.a * 3;
      const bIdx = conn.b * 3;
      linePositions[0] = posArray[aIdx];
      linePositions[1] = posArray[aIdx + 1];
      linePositions[2] = posArray[aIdx + 2];
      linePositions[3] = posArray[bIdx];
      linePositions[4] = posArray[bIdx + 1];
      linePositions[5] = posArray[bIdx + 2];
      conn.line.geometry.attributes.position.needsUpdate = true;

      // 根据距离调整透明度
      const dx = posArray[bIdx] - posArray[aIdx];
      const dy = posArray[bIdx + 1] - posArray[aIdx + 1];
      const dz = posArray[bIdx + 2] - posArray[aIdx + 2];
      const linkDist = Math.sqrt(dx * dx + dy * dy + dz * dz);
      conn.line.material.opacity = Math.max(0.03, 0.2 - linkDist * 0.08);
    }

    renderer.render(scene, camera);
  }

  animate();

  // --- 响应式 ---
  window.addEventListener('resize', () => {
    camera.aspect = container.clientWidth / container.clientHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(container.clientWidth, container.clientHeight);
  });
</script>