---
// 知识星系 — 3D 力导向知识图谱
---

<div id="knowledge-galaxy" class="knowledge-galaxy"></div>

<style>
  .knowledge-galaxy {
    width: 100%;
    height: 560px;
    position: relative;
    margin: 2rem 0 1rem;
    background: transparent;
    border-radius: 0.75rem;
    overflow: hidden;
  }
  @media (max-width: 768px) {
    .knowledge-galaxy { height: 420px; }
  }
</style>

<script>
  import ForceGraph3D from '3d-force-graph';
  import SpriteText from 'three-spritetext';
  import * as THREE from 'three';

  const container = document.getElementById('knowledge-galaxy');
  const isDark = document.documentElement.dataset.theme === 'dark' ||
    (!document.documentElement.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);

  const palette = [
    '#60a5fa', '#a78bfa', '#f472b6', '#38bdf8',
    '#818cf8', '#fb7185', '#22d3ee', '#c084fc',
  ];

  // 知识图谱数据
  const data = {
    nodes: [
      { id: 'Transformer',  group: 'core',  val: 16 },
      { id: 'Attention',    group: 'mech',  val: 12 },
      { id: 'Embedding',    group: 'base',  val: 10 },
      { id: 'GPT',          group: 'model', val: 14 },
      { id: 'BERT',         group: 'model', val: 11 },
      { id: 'RLHF',         group: 'train', val: 10 },
      { id: 'RAG',          group: 'app',   val: 12 },
      { id: 'LoRA',         group: 'train', val: 9 },
      { id: 'CNN',          group: 'base',  val: 10 },
      { id: 'RNN',          group: 'base',  val: 9 },
      { id: 'Diffusion',    group: 'model', val: 10 },
      { id: 'Agent',        group: 'app',   val: 11 },
      { id: 'Tokenization', group: 'base',  val: 9 },
      { id: 'MoE',          group: 'mech',  val: 9 },
      { id: 'Prompt',       group: 'app',   val: 11 },
      { id: 'DPO',          group: 'train', val: 9 },
      { id: 'KV Cache',     group: 'mech',  val: 8 },
      { id: 'SFT',          group: 'train', val: 9 },
      { id: 'LangChain',    group: 'app',   val: 10 },
      { id: 'Vector DB',    group: 'app',   val: 9 },
      { id: 'Flash Attn',   group: 'mech',  val: 8 },
      { id: 'GAN',          group: 'model', val: 9 },
      { id: 'GPTQ',         group: 'train', val: 8 },
      { id: 'DeepSeek',     group: 'model', val: 12 },
    ],
    links: [
      { source: 'Transformer', target: 'Attention',    val: 3 },
      { source: 'Transformer', target: 'Embedding',    val: 2 },
      { source: 'Transformer', target: 'GPT',          val: 3 },
      { source: 'Transformer', target: 'BERT',         val: 2 },
      { source: 'Transformer', target: 'RLHF',         val: 2 },
      { source: 'Transformer', target: 'Flash Attn',   val: 2 },
      { source: 'Attention',   target: 'Embedding',    val: 2 },
      { source: 'Attention',   target: 'KV Cache',     val: 3 },
      { source: 'Attention',   target: 'Flash Attn',   val: 3 },
      { source: 'Embedding',   target: 'Tokenization', val: 3 },
      { source: 'GPT',         target: 'RLHF',         val: 3 },
      { source: 'GPT',         target: 'SFT',          val: 2 },
      { source: 'GPT',         target: 'DPO',          val: 2 },
      { source: 'GPT',         target: 'LoRA',         val: 2 },
      { source: 'GPT',         target: 'GPTQ',         val: 2 },
      { source: 'GPT',         target: 'DeepSeek',     val: 2 },
      { source: 'GPT',         target: 'Prompt',       val: 2 },
      { source: 'BERT',        target: 'Embedding',    val: 2 },
      { source: 'BERT',        target: 'Tokenization', val: 2 },
      { source: 'RLHF',        target: 'DPO',          val: 3 },
      { source: 'RLHF',        target: 'SFT',          val: 2 },
      { source: 'RAG',         target: 'Transformer',  val: 2 },
      { source: 'RAG',         target: 'Prompt',       val: 3 },
      { source: 'RAG',         target: 'Vector DB',    val: 3 },
      { source: 'RAG',         target: 'LangChain',    val: 2 },
      { source: 'Agent',       target: 'RAG',          val: 3 },
      { source: 'Agent',       target: 'Prompt',       val: 2 },
      { source: 'Agent',       target: 'LangChain',    val: 2 },
      { source: 'CNN',         target: 'RNN',          val: 2 },
      { source: 'CNN',         target: 'Transformer',  val: 2 },
      { source: 'RNN',         target: 'Transformer',  val: 2 },
      { source: 'Diffusion',   target: 'GAN',          val: 2 },
      { source: 'Diffusion',   target: 'Transformer',  val: 1 },
      { source: 'GAN',         target: 'CNN',          val: 2 },
      { source: 'LoRA',        target: 'Transformer',  val: 2 },
      { source: 'MoE',         target: 'Transformer',  val: 2 },
      { source: 'MoE',         target: 'GPT',          val: 2 },
      { source: 'MoE',         target: 'DeepSeek',     val: 2 },
      { source: 'DPO',         target: 'SFT',          val: 2 },
      { source: 'KV Cache',    target: 'GPT',          val: 2 },
      { source: 'KV Cache',    target: 'Flash Attn',   val: 2 },
      { source: 'LangChain',   target: 'Vector DB',    val: 2 },
      { source: 'DeepSeek',    target: 'MoE',          val: 3 },
      { source: 'DeepSeek',    target: 'GPTQ',         val: 2 },
    ],
  };

  // 分组颜色
  const groupColors = {
    core:  palette[0],
    mech:  palette[1],
    base:  palette[2],
    model: palette[3],
    train: palette[4],
    app:   palette[5],
  };

  const groupNames = {
    core:  '核心架构',
    mech:  '核心机制',
    base:  '基础概念',
    model: '模型',
    train: '训练方法',
    app:   '应用技术',
  };

  const Graph = ForceGraph3D({ controlType: 'orbit' })(container)
    .graphData(data)
    .backgroundColor('rgba(0,0,0,0)')
    .showNavInfo(false)
    .width(container.clientWidth)
    .height(container.clientHeight)
    // 节点样式
    .nodeRelSize(5)
    .nodeVal(n => n.val)
    .nodeColor(n => groupColors[n.group] || palette[0])
    .nodeOpacity(0.9)
    .nodeResolution(16)
    // 节点标签
    .nodeThreeObject(node => {
      const sprite = new SpriteText(node.id);
      sprite.fontSize = 40;
      sprite.color = groupColors[node.group] || '#fff';
      sprite.fontWeight = 'bold';
      sprite.textHeight = 3;
      sprite.position.y = node.val * 0.3 + 0.8;
      return sprite;
    })
    .nodeThreeObjectExtend(true)
    // 连线
    .linkWidth(l => l.val * 0.5)
    .linkColor(l => {
      const sourceNode = data.nodes.find(n => n.id === (typeof l.source === 'object' ? l.source.id : l.source));
      return sourceNode ? groupColors[sourceNode.group] : '#475569';
    })
    .linkOpacity(0.25)
    .linkDirectionalParticles(2)
    .linkDirectionalParticleWidth(1.5)
    .linkDirectionalParticleSpeed(0.004)
    .enableNodeDrag(false)
    .enableNavigationControls(true)
    .onNodeHover((node, prev) => {
      if (node) {
        container.style.cursor = 'pointer';
        const el = document.querySelector('.graph-info-3d');
        if (!el) {
          const div = document.createElement('div');
          div.className = 'graph-info-3d';
          div.style.cssText = 'position:absolute;top:1rem;left:50%;transform:translateX(-50%);background:var(--sl-color-gray-7);color:var(--sl-color-text);border:1px solid var(--sl-color-gray-4);border-radius:0.5rem;padding:0.4rem 0.9rem;font-size:0.85rem;font-weight:600;pointer-events:none;z-index:10;transition:opacity 0.15s;';
          container.appendChild(div);
        }
        const info = container.querySelector('.graph-info-3d');
        info.innerHTML = `${node.id} <span style="font-weight:400;font-size:0.7rem;color:var(--sl-color-gray-2);margin-left:4px;">${groupNames[node.group]}</span>`;
        info.style.opacity = '1';
      } else {
        container.style.cursor = 'grab';
        const info = container.querySelector('.graph-info-3d');
        if (info) info.style.opacity = '0';
      }
    })
    .onNodeClick(node => {
      const dist = 40;
      const nodePos = { x: node.x, y: node.y, z: node.z };
      Graph.cameraPosition(
        { x: nodePos.x + dist * 0.6, y: nodePos.y + dist * 0.4, z: nodePos.z + dist },
        nodePos,
        1500
      );
    });

  // 配置力模拟
  Graph.d3Force('charge').strength(-400);
  Graph.d3Force('link').distance(50);
  Graph.d3Force('center').strength(0.8);
  Graph.d3VelocityDecay(0.4);
  Graph.numDimensions(3);

  // 力模拟稳定后居中
  setTimeout(() => {
    Graph.zoomToFit(400, 80);
  }, 2500);

  // 响应式
  window.addEventListener('resize', () => {
    Graph.width(container.clientWidth);
    Graph.height(container.clientHeight);
  });
</script>