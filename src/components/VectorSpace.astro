---
// 3D 向量空间球 — 思维向量首页可视化
---

<div id="vector-space-container" class="vector-space-container">
  <canvas id="vector-space-canvas"></canvas>
</div>

<style>
  .vector-space-container {
    width: 100%;
    height: 460px;
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid var(--sl-color-gray-4);
    background: var(--sl-color-gray-7);
    cursor: grab;
    transition: border-color 0.3s;
  }
  :root[data-theme="dark"] .vector-space-container {
    background: var(--sl-color-gray-7);
    border-color: var(--sl-color-gray-5);
  }
  .vector-space-container:active {
    cursor: grabbing;
  }
  .vector-space-container canvas {
    display: block;
  }
  @media (max-width: 768px) {
    .vector-space-container {
      height: 340px;
    }
  }
</style>

<script>
  import * as THREE from 'three';

  const container = document.getElementById('vector-space-container');
  const canvas = document.getElementById('vector-space-canvas');

  // 根据主题获取颜色
  const isDark = document.documentElement.dataset.theme === 'dark' ||
    (!document.documentElement.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);

  const bgColor = isDark ? '#1a1a2e' : '#f0f0f5';
  const gridColor = isDark ? 0x334155 : 0xcbd5e1;
  const gridOpacity = isDark ? 0.15 : 0.25;

  // 场景
  const scene = new THREE.Scene();

  // 相机
  const camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 100);
  camera.position.set(0, 0.5, 6.5);

  // 渲染器
  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
  renderer.setSize(container.clientWidth, container.clientHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setClearColor(0x000000, 0);

  // light/dark 配色
  const palette = isDark
    ? { primary: '#3b82f6', secondary: '#8b5cf6', accent: '#ec4899', light: '#60a5fa', dim: '#475569' }
    : { primary: '#2563eb', secondary: '#7c3aed', accent: '#db2777', light: '#3b82f6', dim: '#94a3b8' };

  // --- 球体线框 ---
  const sphereGeo = new THREE.SphereGeometry(1.85, 64, 40);
  const sphereWire = new THREE.LineSegments(
    new THREE.WireframeGeometry(sphereGeo),
    new THREE.LineBasicMaterial({ color: gridColor, transparent: true, opacity: gridOpacity })
  );
  scene.add(sphereWire);

  // --- 球体表面网格线（经纬线风格） ---
  const ringGroup = new THREE.Group();
  function addLatRing(y, opacity) {
    const r = Math.sqrt(1.85 * 1.85 - y * y);
    const ringGeo = new THREE.TorusGeometry(r, 0.004, 8, 80);
    const ring = new THREE.Mesh(ringGeo, new THREE.MeshBasicMaterial({
      color: gridColor, transparent: true, opacity, depthTest: true,
    }));
    ring.position.y = y;
    ringGroup.add(ring);
  }
  for (let i = -3; i <= 3; i++) {
    addLatRing(i * 0.5, 0.08);
  }
  // 经线
  for (let i = 0; i < 12; i++) {
    const angle = (i / 12) * Math.PI * 2;
    const ringGeo = new THREE.TorusGeometry(1.85, 0.004, 8, 80);
    const ring = new THREE.Mesh(ringGeo, new THREE.MeshBasicMaterial({
      color: gridColor, transparent: true, opacity: 0.08, depthTest: true,
    }));
    ring.rotation.x = Math.PI / 2;
    ring.rotation.y = angle;
    ringGroup.add(ring);
  }
  scene.add(ringGroup);

  // --- 雾状光晕 ---
  const glowGeo = new THREE.SphereGeometry(1.88, 64, 32);
  const glowMat = new THREE.ShaderMaterial({
    uniforms: { uTime: { value: 0 }, uColor: { value: new THREE.Color(palette.primary) } },
    vertexShader: /* glsl */ `
      varying vec3 vNormal; varying vec3 vPosition;
      void main() {
        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
        vNormal = normalize(normalMatrix * normal);
        vPosition = position;
      }
    `,
    fragmentShader: /* glsl */ `
      varying vec3 vNormal; varying vec3 vPosition;
      uniform float uTime; uniform vec3 uColor;
      void main() {
        float intensity = pow(0.6 - dot(vNormal, vec3(0.0, 0.0, 1.0)), 3.0);
        float alpha = intensity * 0.18 + 0.02 * sin(uTime * 0.3 + vPosition.y * 4.0);
        gl_FragColor = vec4(uColor, alpha);
      }
    `,
    transparent: true, blending: THREE.AdditiveBlending, depthWrite: false,
  });
  scene.add(new THREE.Mesh(glowGeo, glowMat));

  // --- 粒子（思维点） ---
  const PARTICLE_COUNT = 160;
  const particlesGeo = new THREE.BufferGeometry();
  const positions = new Float32Array(PARTICLE_COUNT * 3);
  const colors = new Float32Array(PARTICLE_COUNT * 3);
  const velocities = new Float32Array(PARTICLE_COUNT * 3);
  const sizes = new Float32Array(PARTICLE_COUNT);

  const paletteColors = [
    new THREE.Color(palette.primary),
    new THREE.Color(palette.secondary),
    new THREE.Color(palette.accent),
    new THREE.Color(palette.light),
  ];

  for (let i = 0; i < PARTICLE_COUNT; i++) {
    const theta = Math.random() * Math.PI * 2;
    const phi = Math.acos(2 * Math.random() - 1);
    const r = 1.7 * Math.cbrt(Math.random());
    positions[i * 3] = r * Math.sin(phi) * Math.cos(theta);
    positions[i * 3 + 1] = r * Math.sin(phi) * Math.sin(theta);
    positions[i * 3 + 2] = r * Math.cos(phi);

    const c = paletteColors[Math.floor(Math.random() * paletteColors.length)];
    colors[i * 3] = c.r; colors[i * 3 + 1] = c.g; colors[i * 3 + 2] = c.b;

    velocities[i * 3] = (Math.random() - 0.5) * 0.004;
    velocities[i * 3 + 1] = (Math.random() - 0.5) * 0.004;
    velocities[i * 3 + 2] = (Math.random() - 0.5) * 0.004;

    sizes[i] = Math.random() * 2.5 + 1.0;
  }

  particlesGeo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
  particlesGeo.setAttribute('color', new THREE.BufferAttribute(colors, 3));
  particlesGeo.setAttribute('size', new THREE.BufferAttribute(sizes, 1));

  const particleTexCanvas = document.createElement('canvas');
  particleTexCanvas.width = 32; particleTexCanvas.height = 32;
  const pctx = particleTexCanvas.getContext('2d');
  const gradient = pctx.createRadialGradient(16, 16, 0, 16, 16, 16);
  gradient.addColorStop(0, 'rgba(255,255,255,1)');
  gradient.addColorStop(0.1, 'rgba(255,255,255,0.9)');
  gradient.addColorStop(0.3, 'rgba(255,255,255,0.4)');
  gradient.addColorStop(1, 'rgba(255,255,255,0)');
  pctx.fillStyle = gradient;
  pctx.fillRect(0, 0, 32, 32);

  const particles = new THREE.Points(particlesGeo, new THREE.PointsMaterial({
    size: 0.06,
    map: new THREE.CanvasTexture(particleTexCanvas),
    vertexColors: true,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
    transparent: true,
    opacity: 0.9,
    sizeAttenuation: true,
  }));
  scene.add(particles);

  // --- 向量箭头（核心视觉） ---
  const arrowGroup = new THREE.Group();
  const arrows = [];

  function createArrow(from, to, colorHex) {
    const dir = new THREE.Vector3().subVectors(to, from);
    const length = dir.length();
    const mid = new THREE.Vector3().addVectors(from, to).multiplyScalar(0.5);
    dir.normalize();

    const arrow = new THREE.Group();

    // 箭杆
    const shaftGeo = new THREE.CylinderGeometry(0.015, 0.015, length, 8);
    const shaftMat = new THREE.MeshStandardMaterial({
      color: colorHex,
      emissive: colorHex,
      emissiveIntensity: 0.6,
      roughness: 0.3,
      metalness: 0.1,
    });
    const shaft = new THREE.Mesh(shaftGeo, shaftMat);
    shaft.position.y = length / 2;
    arrow.add(shaft);

    // 箭头
    const headGeo = new THREE.ConeGeometry(0.045, 0.15, 8);
    const headMat = new THREE.MeshStandardMaterial({
      color: colorHex,
      emissive: colorHex,
      emissiveIntensity: 0.8,
      roughness: 0.2,
      metalness: 0.2,
    });
    const head = new THREE.Mesh(headGeo, headMat);
    head.position.y = length;
    arrow.add(head);

    // 起点小球
    const dotGeo = new THREE.SphereGeometry(0.04, 8, 8);
    const dot = new THREE.Mesh(dotGeo, new THREE.MeshStandardMaterial({
      color: colorHex,
      emissive: colorHex,
      emissiveIntensity: 1,
      roughness: 0.2,
    }));
    arrow.add(dot);

    // 放置方向
    const quat = new THREE.Quaternion();
    quat.setFromUnitVectors(new THREE.Vector3(0, 1, 0), dir);
    arrow.setRotationFromQuaternion(quat);
    arrow.position.copy(from);

    return arrow;
  }

  // 生成有意义的向量：从球心附近射向不同方向
  const arrowDefs = [
    { from: [-0.2, 0.1, 0.2], to: [0.8, 0.6, 0.4], color: palette.primary },
    { from: [0.1, -0.1, -0.1], to: [-0.7, 0.5, -0.3], color: palette.secondary },
    { from: [-0.1, 0.2, -0.1], to: [0.3, -0.8, 0.5], color: palette.accent },
    { from: [0.2, -0.1, 0.1], to: [-0.5, -0.6, 0.7], color: palette.light },
    { from: [-0.3, 0.0, -0.2], to: [0.9, 0.2, -0.6], color: palette.primary },
    { from: [0.0, 0.1, 0.3], to: [-0.8, -0.3, -0.4], color: palette.secondary },
    { from: [0.1, -0.2, -0.1], to: [0.5, 0.7, 0.3], color: palette.accent },
    { from: [-0.1, 0.0, 0.0], to: [-0.4, -0.7, -0.5], color: palette.light },
    { from: [0.1, 0.1, -0.2], to: [0.6, -0.5, -0.6], color: palette.primary },
    { from: [-0.2, -0.1, 0.1], to: [-0.6, 0.7, 0.2], color: palette.secondary },
  ];

  for (const def of arrowDefs) {
    const from = new THREE.Vector3(...def.from);
    const to = new THREE.Vector3(...def.to);
    const arrow = createArrow(from, to, def.color);
    arrowGroup.add(arrow);
    arrows.push({ arrow, from: from.clone(), to: to.clone(), color: def.color });
  }
  scene.add(arrowGroup);

  // --- 发光节点（思维核心） ---
  const nodeGroup = new THREE.Group();
  const nodeDefs = [
    [0, 0, 0], [0.5, 0.3, 0.4], [-0.4, -0.5, 0.3], [0.3, -0.6, -0.2],
    [-0.6, 0.4, -0.4], [0.7, -0.3, 0.5], [-0.3, 0.6, -0.5], [0.4, 0.5, -0.6],
  ];

  const nodeMeshes = [];
  for (const [x, y, z] of nodeDefs) {
    const nodeGeo = new THREE.SphereGeometry(0.06, 16, 16);
    const nodeColor = paletteColors[Math.floor(Math.random() * paletteColors.length)];
    const node = new THREE.Mesh(nodeGeo, new THREE.MeshStandardMaterial({
      color: nodeColor,
      emissive: nodeColor,
      emissiveIntensity: 1.5,
      roughness: 0.2,
      metalness: 0.3,
    }));
    node.position.set(x, y, z);
    node.userData = { color: nodeColor, baseX: x, baseY: y, baseZ: z, phase: Math.random() * Math.PI * 2 };
    nodeGroup.add(node);
    nodeMeshes.push(node);
  }
  scene.add(nodeGroup);

  // --- 节点光晕（sprite） ---
  const haloGroup = new THREE.Group();
  const haloCanvas = document.createElement('canvas');
  haloCanvas.width = 64; haloCanvas.height = 64;
  const hctx = haloCanvas.getContext('2d');
  const hgradient = hctx.createRadialGradient(32, 32, 0, 32, 32, 32);
  hgradient.addColorStop(0, 'rgba(255,255,255,0.5)');
  hgradient.addColorStop(0.3, 'rgba(255,255,255,0.2)');
  hgradient.addColorStop(1, 'rgba(255,255,255,0)');
  hctx.fillStyle = hgradient;
  hctx.fillRect(0, 0, 64, 64);
  const haloTexture = new THREE.CanvasTexture(haloCanvas);

  for (const [x, y, z] of nodeDefs) {
    const spriteMat = new THREE.SpriteMaterial({
      map: haloTexture,
      blending: THREE.AdditiveBlending,
      depthWrite: false,
      transparent: true,
      opacity: 0.5,
    });
    const sprite = new THREE.Sprite(spriteMat);
    sprite.position.set(x, y, z);
    sprite.scale.set(0.4, 0.4, 1);
    haloGroup.add(sprite);
  }
  scene.add(haloGroup);

  // --- 连线（节点之间） ---
  const linkGroup = new THREE.Group();
  for (let i = 0; i < nodeDefs.length; i++) {
    for (let j = i + 1; j < nodeDefs.length; j++) {
      const dist = Math.sqrt(
        (nodeDefs[i][0] - nodeDefs[j][0]) ** 2 +
        (nodeDefs[i][1] - nodeDefs[j][1]) ** 2 +
        (nodeDefs[i][2] - nodeDefs[j][2]) ** 2
      );
      if (dist < 1.3) {
        const linkGeo = new THREE.BufferGeometry().setFromPoints([
          new THREE.Vector3(...nodeDefs[i]),
          new THREE.Vector3(...nodeDefs[j]),
        ]);
        const link = new THREE.Line(linkGeo, new THREE.LineBasicMaterial({
          color: paletteColors[Math.floor(Math.random() * paletteColors.length)],
          transparent: true,
          opacity: 0.12 + (1.3 - dist) * 0.2,
          blending: THREE.AdditiveBlending,
          depthWrite: false,
        }));
        linkGroup.add(link);
      }
    }
  }
  scene.add(linkGroup);

  // --- 光照 ---
  scene.add(new THREE.AmbientLight(0xffffff, 0.5));
  const dirLight = new THREE.DirectionalLight(0xffffff, 0.8);
  dirLight.position.set(2, 3, 4);
  scene.add(dirLight);

  // --- 鼠标交互 ---
  let mouseX = 0, mouseY = 0;
  let targetRotX = 0.3, targetRotY = 0.4;
  let isDragging = false, prevMX = 0, prevMY = 0;

  container.addEventListener('mousemove', (e) => {
    const rect = container.getBoundingClientRect();
    const x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
    const y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
    if (isDragging) {
      targetRotY += (x - prevMX) * 2.5;
      targetRotX += (y - prevMY) * 2.5;
    }
    prevMX = x; prevMY = y;
    mouseX = x; mouseY = y;
  });
  container.addEventListener('mousedown', () => { isDragging = true; });
  container.addEventListener('mouseup', () => { isDragging = false; });
  container.addEventListener('mouseleave', () => { isDragging = false; });
  container.addEventListener('touchmove', (e) => {
    if (e.touches.length === 1) {
      const rect = container.getBoundingClientRect();
      const x = ((e.touches[0].clientX - rect.left) / rect.width) * 2 - 1;
      const y = -((e.touches[0].clientY - rect.top) / rect.height) * 2 + 1;
      targetRotY += (x - prevMX) * 2.5;
      targetRotX += (y - prevMY) * 2.5;
      prevMX = x; prevMY = y;
    }
  });

  // --- 动画 ---
  const clock = new THREE.Clock();
  function animate() {
    requestAnimationFrame(animate);
    const dt = Math.min(clock.getDelta(), 0.1);
    const t = performance.now() * 0.001;

    if (!isDragging) {
      targetRotY += dt * 0.12;
    }
    targetRotY += (mouseX * 0.4 - targetRotY) * 0.015;
    targetRotX += (mouseY * 0.25 - targetRotX) * 0.015;
    scene.rotation.y += (targetRotY - scene.rotation.y) * 0.04;
    scene.rotation.x += (targetRotX - scene.rotation.x) * 0.04;

    glowMat.uniforms.uTime.value = t;

    // 粒子运动
    const posArr = particlesGeo.attributes.position.array;
    for (let i = 0; i < PARTICLE_COUNT; i++) {
      const idx = i * 3;
      posArr[idx] += velocities[idx];
      posArr[idx + 1] += velocities[idx + 1];
      posArr[idx + 2] += velocities[idx + 2];
      const dist = Math.sqrt(posArr[idx] ** 2 + posArr[idx + 1] ** 2 + posArr[idx + 2] ** 2);
      if (dist > 1.7) {
        const nx = posArr[idx] / dist, ny = posArr[idx + 1] / dist, nz = posArr[idx + 2] / dist;
        const dot = velocities[idx] * nx + velocities[idx + 1] * ny + velocities[idx + 2] * nz;
        velocities[idx] -= 2 * dot * nx;
        velocities[idx + 1] -= 2 * dot * ny;
        velocities[idx + 2] -= 2 * dot * nz;
        velocities[idx] += (Math.random() - 0.5) * 0.0008;
        velocities[idx + 1] += (Math.random() - 0.5) * 0.0008;
        velocities[idx + 2] += (Math.random() - 0.5) * 0.0008;
        posArr[idx] = nx * 1.68; posArr[idx + 1] = ny * 1.68; posArr[idx + 2] = nz * 1.68;
      }
    }
    particlesGeo.attributes.position.needsUpdate = true;

    // 节点微动
    for (const node of nodeMeshes) {
      const { baseX, baseY, baseZ, phase } = node.userData;
      node.position.x = baseX + Math.sin(t * 0.8 + phase) * 0.04;
      node.position.y = baseY + Math.cos(t * 0.6 + phase) * 0.04;
      node.position.z = baseZ + Math.sin(t * 0.7 + phase + 1) * 0.04;
    }

    renderer.render(scene, camera);
  }
  animate();

  // 响应式
  window.addEventListener('resize', () => {
    camera.aspect = container.clientWidth / container.clientHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(container.clientWidth, container.clientHeight);
  });

  // 主题切换监听
  const observer = new MutationObserver(() => {
    // 主题变化时刷新页面以应用新颜色
    const newIsDark = document.documentElement.dataset.theme === 'dark' ||
      (!document.documentElement.dataset.theme && window.matchMedia('(prefers-color-scheme: dark)').matches);
    if (newIsDark !== isDark) {
      window.location.reload();
    }
  });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    window.location.reload();
  });
</script>